; JD Cookie Sync to Qinglong
; 自动抓取京东 Cookie 并同步到青龙面板
; https://github.com/gjzbbs/jd_surge

hostname = api.m.jd.com

; 京东 2026-09 起把 functionId 和设备指纹（uuid / x-api-eid-token / wg-sdk-token /
; d_brand / d_model / osVersion / build / clientVersion）全放进了 POST 请求体。
; 只读请求头永远缺这些字段，所以这里必须用 script-request-body。
^https?:\/\/api\.m\.jd\.com\/client\.action url script-request-body https://raw.githubusercontent.com/gjzbbs/jd_surge/main/jd_cookie_sync.js
